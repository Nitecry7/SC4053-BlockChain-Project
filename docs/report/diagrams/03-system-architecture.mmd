flowchart TB
  classDef engine fill:#E6F0F8,stroke:#0072B2,stroke-width:2px,color:#1A1A1A
  classDef p2 fill:#FFF1D6,stroke:#E69F00,stroke-width:2px,color:#1A1A1A
  classDef neutral fill:#F4F4F4,stroke:#666666,stroke-width:1.5px,color:#1A1A1A
