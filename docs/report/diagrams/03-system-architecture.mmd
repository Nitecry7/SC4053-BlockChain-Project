  FE["Next.js frontend<br/>wagmi + viem, no backend<br/>[Person 2]"]:::p2
  MM["MetaMask<br/>holds keys, signs<br/>[user]"]:::neutral
  K["Any caller<br/>keeper or trader<br/>[anyone]"]:::good

  subgraph CHAIN[" "]
    OB["OrderBook, one per pair<br/>holds ALL escrow<br/>matches and settles<br/>[Person 1 engine]"]:::engine
    TB["ON-CHAIN (Anvil 31337)<br/>trust boundary: no owner,<br/>admin, pause or upgrade"]:::neutral
    MF["MarketFactory<br/>one market per pair<br/>[Person 2]"]:::p2
    TK["DemoToken ERC20s<br/>fixed supply<br/>[Person 2]"]:::p2
    TF["TokenFactory<br/>[Person 2]"]:::p2
  end

  FE -->|"1 asks to sign"| MM
