  "lineColor": "#555555",
  "clusterBkg": "#FAFAFA",
  "clusterBorder": "#9A9A9A",
  "edgeLabelBackground": "#FFFFFF",
  "noteBkgColor": "#FFFBEA",
  "noteBorderColor": "#9A7B00",
  "noteTextColor": "#1A1A1A",
  "actorBkg": "#E6F0F8",
  "actorBorder": "#0072B2",
  "actorTextColor": "#1A1A1A",
  "signalColor": "#333333",
  "signalTextColor": "#1A1A1A",
  "sequenceNumberColor": "#FFFFFF",
  "labelBoxBkgColor": "#F4F4F4",
  "labelBoxBorderColor": "#9A9A9A",
  "loopTextColor": "#1A1A1A",
  "activationBkgColor": "#DCEBF7",
  "activationBorderColor": "#0072B2",
  "taskBkgColor": "#E6F0F8",
  "taskBorderColor": "#0072B2",
  "taskTextColor": "#1A1A1A",
  "taskTextDarkColor": "#1A1A1A",
