  "gridColor": "#DDDDDD",
  "sectionBkgColor": "#FAFAFA",
  "altSectionBkgColor": "#FFFFFF",
  "sectionBkgColor2": "#FAFAFA",
  "todayLineColor": "#FFFFFF"
 },
 "flowchart": {
  "htmlLabels": true,
  "curve": "linear",
  "nodeSpacing": 45,
  "rankSpacing": 55,
  "padding": 14,
  "useMaxWidth": false
 },
 "sequence": {
  "mirrorActors": false,
  "showSequenceNumbers": true,
  "actorMargin": 70,
  "messageFontSize": 15,
  "noteFontSize": 14,
  "useMaxWidth": false,
  "wrap": true,
  "width": 170
 },
 "state": {
  "useMaxWidth": false
 },
 "gantt": {
  "fontSize": 14,
  "sectionFontSize": 14,
  "barHeight": 26,
  "barGap": 8,
  "topPadding": 60,
  "leftPadding": 250,
  "useMaxWidth": false,
  "axisFormat": "%d %b"
 }
}