# Public values only. Never put a private key or any secret in a NEXT_PUBLIC_ variable: they are shipped to the browser.

# JSON-RPC endpoint of the local Anvil node (chain id 31337).
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Optional WalletConnect Cloud project id (a public identifier). Leave empty to use desktop browser wallets
# (MetaMask) only. See docs/FRONTEND.md.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
